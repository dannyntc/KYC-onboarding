generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma-postgres"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id String @id
  name String
  expectedMonthlyMin Int
  expectedMonthlyMax Int
  declaredWealth Int
  profile String
  transactions Transaction[]
  accounts Account[]
  alerts Alert[]
  documents KYCDocument[]
  relationships Relationship[]
  onboarding OnboardingCase?
  identityDocuments IdentityDocument[]
  screeningResults ScreeningResult[]
}

model Account {
  id String @id
  clientId String @unique
  client Client @relation(fields: [clientId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id String @id
  clientId String
  client Client @relation(fields: [clientId], references: [id])
  accountId String?
  account Account? @relation(fields: [accountId], references: [id])
  date String
  amount Int
  currency String
  counterparty String
}

model Alert {
  id String @id
  clientId String
  client Client @relation(fields: [clientId], references: [id])
  scenario String
  title String
  priority String
  status String
  triggerTransactionId String
  notes String @default("")
  version Int @default(0)
  analyses Analysis[]
  events AuditEvent[]
}

model Analysis {
  id Int @id @default(autoincrement())
  alertId String
  alert Alert @relation(fields: [alertId], references: [id])
  mode String
  model String @default("fixture")
  promptVersion String @default("v1")
  validation String @default("passed")
  output String
  rawResponse String?
  inputSnapshot String?
  createdAt DateTime @default(now())
}

model AuditEvent {
  id Int @id @default(autoincrement())
  alertId String
  alert Alert @relation(fields: [alertId], references: [id])
  actor String
  action String
  detail String
  createdAt DateTime @default(now())
}

model KYCDocument {
  id String @id
  clientId String
  client Client @relation(fields: [clientId], references: [id])
  kind String
  title String
  summary String
  corroboratedAmount Int
}

model Relationship {
  id String @id
  clientId String
  client Client @relation(fields: [clientId], references: [id])
  owner String
  entity String
  description String
}

model AnalysisLock {
  alertId String @id
  token String
  expiresAt DateTime
}

model OnboardingCase {
  id              String               @id
  clientId        String               @unique
  client          Client               @relation(fields: [clientId], references: [id])
  applicationDate String
  purpose         String
  status          String               @default("In progress")
  riskRating      String?
  riskRationale   String               @default("")
  notes           String               @default("")
  version         Int                  @default(0)
  events          OnboardingEvent[]
  analyses        OnboardingAnalysis[]
}

model IdentityDocument {
  id        String  @id
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  kind      String
  title     String
  status    String
  expiresOn String?
  summary   String
}

model ScreeningResult {
  id                String @id
  clientId          String
  client            Client @relation(fields: [clientId], references: [id])
  list              String
  matchedName       String
  matchStrength     String
  summary           String
  disposition       String @default("Potential match")
  dispositionReason String @default("")
}

model OnboardingEvent {
  id               Int            @id @default(autoincrement())
  onboardingCaseId String
  onboardingCase   OnboardingCase @relation(fields: [onboardingCaseId], references: [id])
  actor            String
  action           String
  detail           String
  createdAt        DateTime       @default(now())
}

model OnboardingAnalysis {
  id               Int            @id @default(autoincrement())
  onboardingCaseId String
  onboardingCase   OnboardingCase @relation(fields: [onboardingCaseId], references: [id])
  mode             String
  model            String         @default("fixture")
  promptVersion    String         @default("v1")
  validation       String         @default("passed")
  output           String
  rawResponse      String?
  inputSnapshot    String?
  createdAt        DateTime       @default(now())
}
