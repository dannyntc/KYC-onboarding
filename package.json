{
  "name": "kyc-onboarding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:onboarding": "tsx prisma/seed-onboarding.ts",
    "db:reset": "KYC_ONBOARDING_RESET=1 tsx prisma/seed.ts",
    "db:migrate:postgres": "DATABASE_ENGINE=postgres prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "db:seed:postgres": "DATABASE_ENGINE=postgres tsx prisma/seed-postgres.ts",
    "db:seed:onboarding:postgres": "DATABASE_ENGINE=postgres tsx prisma/seed-onboarding-postgres.ts",
    "db:reset:postgres": "DATABASE_ENGINE=postgres KYC_ONBOARDING_RESET=1 tsx prisma/seed-postgres.ts",
    "vercel-build": "prisma generate --schema prisma/schema.prisma && DATABASE_ENGINE=postgres prisma generate --schema prisma/schema.postgres.prisma && next build",
    "test:e2e": "node scripts/e2e.mjs",
    "postinstall": "prisma generate",
    "test:e2e:live": "node scripts/e2e-live.mjs",
    "test:e2e:public": "node scripts/e2e-public.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "driver.js": "^1.14.0",
    "next": "16.4.6",
    "openai": "^7.62.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  },
  "type": "module"
}
